# Copiar a .env (ignorado por git). Todos los valores son ficticios.

# --- Aplicacion ---
DATABASE_URL=postgresql+psycopg://turnos:turnos_dev@localhost:5432/turnos
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60
APP_TIMEZONE=America/Argentina/Buenos_Aires
NOTIFICATION_ADAPTER=mock
CORS_ORIGINS=http://localhost:5173

# --- Tests (base separada, solo la usa tests/conftest.py) ---
TEST_DATABASE_URL=postgresql+psycopg://turnos:turnos_dev@localhost:5432/turnos_test

# --- Contenedor PostgreSQL (docker compose) ---
POSTGRES_USER=turnos
POSTGRES_PASSWORD=turnos_dev
POSTGRES_DB=turnos
POSTGRES_PORT=5432

# Contraseñas de desarrollo para el seed (ficticias; si una falta, ese usuario no se crea)
SEED_RECEPCIONISTA_PASSWORD=dev-recepcion-ficticia
SEED_ODONTOLOGO_1_PASSWORD=dev-odontologo1-ficticia
SEED_ODONTOLOGO_2_PASSWORD=dev-odontologo2-ficticia